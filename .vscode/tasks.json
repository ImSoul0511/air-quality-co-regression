{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: build report/main.tex",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-synctex=1",
        "main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/report"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "LaTeX: clean report build",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-C",
        "main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/report"
      },
      "problemMatcher": []
    }
  ]
}
